{
  "manifest_version": 3,
  "name": "GC Protect — AI Data Privacy",
  "version": "3.1.0",
  "description": "Protect sensitive data (SSNs, emails, API keys, client info) before it reaches ChatGPT, Claude, Gemini, Perplexity, and Grok. All tokenization happens in your browser — nothing is sent to our servers.",
  "author": "Gratia Core Enterprise LLC",
  "homepage_url": "https://www.gcprotect.tech",
  "permissions": ["storage", "activeTab", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://perplexity.ai/*",
    "https://grok.com/*",
    "https://gcprotect.tech/*",
    "https://www.gcprotect.tech/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://www.perplexity.ai/*",
        "https://perplexity.ai/*",
        "https://grok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.gcprotect.tech/extension-signin*",
        "https://gcprotect.tech/extension-signin*"
      ],
      "js": ["signin-bridge.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "GC Protect"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
